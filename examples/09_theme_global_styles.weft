# Global styles, CSS variables, media queries and a dark-mode toggle.
# Exercises: style global (ADR 0011), selectors starting with ':' and '@',
# ':' inside at-rules, element and string selectors (0004).

style global:
    :root:
        --bg: white
        --fg: #222
        --accent: royalblue
    .dark:
        --bg: #111
        --fg: #eee
    body:
        margin: 0
        font-family: system-ui, sans-serif
    @media (max-width: 600px):
        body:
            font-size: 15px

page "Theme" lang="en":
    state dark = False

    div.app class:dark=dark:
        style:
            background: var(--bg)
            color: var(--fg)
            min-height: 100vh
            padding: 2rem
            @media (max-width: 600px):
                padding: 1rem
            a:
                color: var(--accent)
            "> p":
                line-height: 1.6

        h1 "Theme demo"
        p "Toggle dark mode below."
        label:
            input type="checkbox" bind=dark
            " Dark mode"
        p:
            a href="https://example.com" target="_blank" "An external link"
