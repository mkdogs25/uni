# The brief's illustrative example, made complete.
# Exercises: state, interpolation, scoped style, pseudo-state, events,
# if/else, for, attributes then trailing text (ADRs 0004-0006, 0012).

page "Counter":
    state count = 0
    state items = [{name: "Apples"}, {name: "Pears"}]

    div.box#main:
        style:
            padding: 16px
            border-radius: 8px

        h1 "Hello"

        button.primary "Clicked {count}":
            style:
                padding: 8px 16px
                background: blue
                hover:
                    background: darkblue
            on click:
                count += 1

        if count > 5:
            p "That's a lot of clicks"
        else:
            p "Keep going"

        ul:
            for item in items:
                li "{item.name}"

        a.link href="/home" "Home"
        img src="cat.png" alt="A cat"
