# Searchable, filterable list with conditional rendering.
# Exercises: for with nested if, empty state without special syntax
# (ADR 0018), derived filtering, enumerate, select binding, multi-line
# literal (0009), class toggles with expressions (0008).

page "Animals":
    state query = ""
    state kind = "all"
    state animals = [
        {name: "Cat", kind: "mammal", legs: 4},
        {name: "Sparrow", kind: "bird", legs: 2},
        {name: "Dog", kind: "mammal", legs: 4},
        {name: "Snake", kind: "reptile", legs: 0},
    ]

    def matches(a) -> bool:
        return query.lower() in a.name.lower() and (kind == "all" or a.kind == kind)

    derived shown = [a for a in animals if matches(a)]

    section:
        style:
            .odd:
                background: #f6f6f6

        input type="search" placeholder="Search" bind=query
        select bind=kind:
            option value="all" "All"
            option value="mammal" "Mammals"
            option value="bird" "Birds"
            option value="reptile" "Reptiles"

        p.count "{len(shown)} of {len(animals)} shown"

        ol:
            for i, a in enumerate(shown) key a.name:
                li class:odd=(i % 2 == 1):
                    strong "{a.name}"
                    " is a {a.kind}"
                    if a.legs == 0:
                        em " with no legs"
                    else:
                        " with {a.legs} legs"

        if not shown:
            p.none "No matches for “{query}”."
