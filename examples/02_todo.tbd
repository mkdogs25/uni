# Todo list.
# Covers: list state, mutation vs reassignment, two-way binding, derived values,
# keyed loops, event modifiers, functions.

page "Todos":
    state todos: list = []
    state draft = ""
    state next_id = 1

    derived remaining = len([t for t in todos if not t.done])   # Q12 derived

    def add():
        if draft.strip() == "":
            return
        todos.append({id: next_id, text: draft.strip(), done: False})  # Q5 mutation
        next_id += 1
        draft = ""

    def remove(todo):
        todos = [t for t in todos if t.id != todo.id]               # reassignment

    main.todo-app:
        style:
            max-width: 32rem
            margin: 2rem auto
            font-family: system-ui, sans-serif

        h1 "Todos ({remaining} left)"

        form:
            on submit.prevent:                     # Q11 modifiers
                add()
            input type="text" placeholder="What needs doing?" bind=draft   # Q13
            button type="submit" disabled=(draft == "") "Add"            # Q9

        ul.list:
            style:
                list-style: none
                padding: 0
            for todo in todos key todo.id:         # Q5 keyed loop
                li:
                    style:
                        display: flex
                        gap: 0.5rem
                        align-items: center
                    input type="checkbox" bind=todo.done
                    span.text class:done=todo.done "{todo.text}"   # Q9 conditional class
                        style:
                            &.done:                # Q2 compound selector
                                text-decoration: line-through
                                opacity: 0.6
                    button.remove "×":
                        on click:
                            remove(todo)

        if len(todos) == 0:
            p.empty "Nothing to do."
