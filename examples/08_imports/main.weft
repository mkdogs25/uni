# Imports, props, callbacks and components as tags.
# Exercises: dotted relative imports (ADR 0010), lambdas as props (0019),
# slots (0016), light type checking (0020).

from .components.button import Button

component Panel(heading: str):
    section.panel:
        style:
            padding: 1rem
            border: 1px solid #ccc
        h3 "{heading}"
        slot

page "Imports":
    state log: list[str] = []

    Panel heading="Actions":
        Button label="Save" on_press=(lambda: log.append("saved"))
        Button label="Delete" kind="danger" on_press=(lambda: log.append("deleted"))

    Panel heading="Log":
        for entry in log:
            p "{entry}"
        if not log:
            p "Nothing yet."
