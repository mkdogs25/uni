# A reusable card with hover styles, props and a slot.
# Exercises: component signature props (ADR 0010), slot (0016), nested
# pseudo-states and ':' inside values (0004), '#' in values (0007),
# dynamic style values (0011).

component Card(title: str, accent: str = "steelblue", featured: bool = False):
    article.card class:featured=featured:
        style:
            border: 1px solid #ddd
            border-radius: 12px
            padding: 1rem
            transition: transform 150ms ease, box-shadow 150ms ease
            background: url("data:image/svg+xml;utf8,<svg/>") no-repeat
            hover:
                transform: translateY(-2px)
                box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15)
            &.featured:
                border-color: {accent}
            focus-within:
                outline: 2px solid {accent}

        h2 "{title}":
            style:
                margin: 0 0 0.5rem
                color: {accent}
        slot

page "Cards":
    div.grid:
        style:
            display: grid
            grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr))
            gap: 1rem

        Card title="Plain":
            p "A card with default colours."
        Card title="Featured" accent="tomato" featured=True:
            p "This one is highlighted."
            a href="#more" "Read more"
