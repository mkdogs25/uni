# A clock and a stopwatch.
# Exercises: timers, mount/unmount cleanup, watch (ADR 0014), JS interop and
# JS methods on values (0019), component-level plain variables (0017),
# quotes inside interpolation (0009).

component Clock:
    state now = js.Date.new()
    timer = None

    def tick():
        now = js.Date.new()

    on mount:
        timer = every(1000, tick)
    on unmount:
        cancel(timer)

    time "{now.toLocaleTimeString()}"

component Stopwatch:
    state running = False
    state elapsed = 0
    state laps: list[int] = []
    timer = None

    def tick():
        elapsed += 100

    watch running:
        if running:
            timer = every(100, tick)
        else:
            cancel(timer)

    on unmount:
        cancel(timer)

    div.stopwatch:
        p.time "{(elapsed / 1000).toFixed(1)}s"
        button "{'Stop' if running else 'Start'}":
            on click:
                running = not running
        button "Lap" disabled=(not running):
            on click:
                laps.append(elapsed)
        ol:
            for lap in laps:
                li "{(lap / 1000).toFixed(1)}s"

page "Time":
    Clock
    Stopwatch
