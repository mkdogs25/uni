# Strings, multi-line text and escaping: the lexer's edge cases (ADR 0009).
# Exercises: closing-delimiter dedent, literal braces, both quote kinds,
# escapes, raw strings, raw HTML (0008), trailing-backslash continuation.

page "Text":
    state name = "world"

    article:
        p "Hello, {name}!"
        p "Braces are written {{like this}}."
        p 'Single quotes work and "doubles" inside.'
        p "Tabs\tand\nnewlines are escapes; \"quotes\" too."

        p """
            This paragraph spans several lines.
            Leading spaces up to the closing quotes are stripped,
            and {name} still interpolates.
            """

        pre """
            def keep():
                return "indentation inside pre is preserved"
            """

        div html="<em>trusted</em> raw HTML"

        a.button.big#cta href="/start" target="_self" \
            title="A long tag continued on the next line" "Start"

        p r"Raw string: {not interpolated}\n"
