# Load JSON from an API.
# Exercises: async def / await, on mount (ADR 0014), loading and error
# states, try/except/finally (0017), optional union hint (0021).

page "Users":
    state users = []
    state loading = True
    state error: str | None = None

    async def load():
        loading = True
        error = None
        try:
            users = await fetch_json("https://jsonplaceholder.typicode.com/users")
        except Exception as e:
            error = str(e)
        finally:
            loading = False

    on mount:
        await load()

    div:
        h1 "Users"
        button "Reload":
            on click:
                await load()

        if loading:
            p "Loading…"
        elif error:
            p.error "Could not load users: {error}"
        else:
            ul:
                for u in users key u.id:
                    li:
                        a href="mailto:{u.email}" "{u.name}"
                        " ({u.company.name})"
